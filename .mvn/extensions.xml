<extensions xmlns="http://maven.apache.org/EXTENSIONS/1.0.0">
  <extension>
    <groupId>org.apache.maven.wagon</groupId>
    <artifactId>wagon-ssh-external</artifactId>
    <version>3.5.3</version>
  </extension>
  <!-- Artifact Registry wagon for the artifactregistry:// repository in pom.xml (needs Maven 3.3.1 or later).
       Credentials: Application Default Credentials first, then the active gcloud login; Maven <server> entries
       are ignored (https://cloud.google.com/artifact-registry/docs/java/authentication).
       CI mirrors clutch-ar to the https URL with its own token, so the wagon is loaded there but not used. -->
  <extension>
    <groupId>com.google.cloud.artifactregistry</groupId>
    <artifactId>artifactregistry-maven-wagon</artifactId>
    <version>2.2.5</version>
  </extension>
</extensions>
